{
  "name": "opus-atlas-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "APP_ENV=prd nest start",
    "start:dev": "APP_ENV=hml nest start --watch",
    "start:local": "APP_ENV=local nest start --watch",
    "start:prod": "APP_ENV=prd node dist/main",
    "start:hml": "APP_ENV=hml node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "npm run build && APP_ENV=local node --env-file=.env.local dist/scripts/db-push.js",
    "prisma:push:hml": "npm run build && APP_ENV=hml node --env-file=.env.hml dist/scripts/db-push.js",
    "hml:export": "APP_ENV=local node --env-file=.env.local dist/scripts/export-hml.js",
    "db:restore": "APP_ENV=local node --env-file=.env.local dist/scripts/restore.js",
    "seed:pricing:hml": "npm run build && APP_ENV=hml node --env-file=.env.hml dist/scripts/seed-plan-pricing.js",
    "seed:pricing:prd": "npm run build && APP_ENV=prd node --env-file=.env.prd dist/scripts/seed-plan-pricing.js",
    "admin:promote:hml": "npm run build && APP_ENV=hml node --env-file=.env.hml dist/scripts/promote-admin.js",
    "admin:promote:prd": "npm run build && APP_ENV=prd node --env-file=.env.prd dist/scripts/promote-admin.js",
    "env:check": "node dist/scripts/env-check.js",
    "prisma:studio": "node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:debug": "APP_ENV=local nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "storage:migrate-local": "node dist/scripts/migrate-local-uploads.js",
    "storage:migrate-local:apply": "node dist/scripts/migrate-local-uploads.js --apply",
    "storage:cleanup-pending": "node dist/scripts/cleanup-pending-uploads.js",
    "storage:drop-lost": "node dist/scripts/drop-lost-local-files.js",
    "storage:drop-lost:apply": "node dist/scripts/drop-lost-local-files.js --apply",
    "portal:normalize-assignments": "node dist/scripts/normalize-assignments.js",
    "portal:normalize-assignments:apply": "node dist/scripts/normalize-assignments.js --apply",
    "catalog:fix-imslp-thumbnails": "node dist/scripts/fix-imslp-thumbnails.js",
    "catalog:fix-imslp-thumbnails:apply": "node dist/scripts/fix-imslp-thumbnails.js --apply",
    "catalog:import-legacy-bios": "node dist/scripts/import-legacy-bios.js",
    "catalog:import-legacy-bios:apply": "node dist/scripts/import-legacy-bios.js --apply",
    "users:audit-admin-roles": "node dist/scripts/audit-admin-roles.js",
    "catalog:sync-annotation-counts": "node dist/scripts/sync-annotation-counts.js",
    "catalog:sync-annotation-counts:apply": "node dist/scripts/sync-annotation-counts.js --apply",
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "prisma:push:raw": "node --env-file=.env.local node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.73.0",
    "argon2": "^0.45.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.4",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.30.0",
    "puppeteer-core": "^24.30.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/main\\.ts$",
      "<rootDir>/scripts/",
      "\\.module\\.ts$",
      "__fixtures__"
    ]
  }
}
