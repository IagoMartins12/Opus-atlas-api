  userId     String @db.ObjectId
  composerId String @db.ObjectId

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  composer Composer @relation(fields: [composerId], references: [id], onDelete: Cascade) // 🔄 CASCADE quando deletar composer

  @@unique([userId, composerId])
}

model WorkAnnotation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId

  // Conteúdo da anotação
  title    String // Título/resumo da anotação
  content  String // Conteúdo principal
  category AnnotationCategory @default(GENERAL)

  // Localização na obra
  scope        AnnotationScope @default(ENTIRE_WORK)
  measureStart Int? // Compasso inicial (se específico)
  measureEnd   Int? // Compasso final (se range)
  movement     String? // Nome do movimento
  section      String? // Nome da seção (ex: "Exposição", "Desenvolvimento")
  pageNumber   Int? // Página da partitura (se aplicável)

  // Metadata musical
  hand       String? // "left", "right", "both"
  voice      String? // "soprano", "alto", "tenor", "bass"
  instrument String? // Instrumento específico (para obras de conjunto)

  // Classificação e utilidade
  difficulty AnnotationDifficulty @default(ALL_LEVELS)
  tags       String[]             @default([])

  // Interação social
  isPublic     Boolean @default(true)
  isVerified   Boolean @default(false) // Verificado por moderador/expert
  helpfulCount Int     @default(0) // Quantos acharam útil
  viewCount    Int     @default(0) // Visualizações

  // Moderação
  isFlagged   Boolean   @default(false)
  flagReason  String?
  moderatedBy String?   @db.ObjectId
  moderatedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade) // 🔄 CASCADE quando deletar work

  // Relações de interação
  helpfulVotes AnnotationHelpfulVote[]

  // Índices otimizados
  @@index([workId, isPublic, category])
  @@index([workId, scope, measureStart])
  @@index([userId, createdAt])
  @@index([category, difficulty])
  @@index([isPublic, helpfulCount])
  @@index([tags])
  @@index([isVerified, isPublic])
  @@index([workId, isPublic]) // Para contagem de anotações públicas
  @@index([userId, isPublic]) // Para stats de usuário
  @@index([workId, isPublic, createdAt]) // Para anotações recentes
  @@map("work_annotations")
}

model AnnotationHelpfulVote {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  annotationId String   @db.ObjectId
  isHelpful    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotation WorkAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  @@unique([userId, annotationId])
  @@index([annotationId, isHelpful])
  @@map("annotation_helpful_votes")
}

model FavoriteScore {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  workId      String      @db.ObjectId
  scoreId     String // ID da partitura no cache (WorkScore.sourceId)
  scoreSource ScoreSource @default(IMSLP) // IMSLP, CUSTOM, etc.

  // Dados da partitura no momento do favoritamento (para histórico)
  scoreTitle  String
  scoreType   IMSLPScoreType
  downloadUrl String?
  fileSize    String?
  pageCount   String?

  // Metadados do favorito
  notes        String? // Notas pessoais do usuário sobre a partitura
  tags         String[] @default([]) // Tags pessoais
  addedAt      DateTime @default(now())
  lastAccessed DateTime @default(now())
  accessCount  Int      @default(0)

  // Avaliação pessoal (opcional)
  personalRating Int? // 1-5 estrelas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade) // 🔄 CASCADE quando deletar work

  // Índices otimizados
  @@unique([userId, workId, scoreId, scoreSource], name: "user_work_score_unique")
  @@index([userId, workId])
  @@index([workId, scoreId])
  @@index([scoreSource, scoreType])
  @@index([addedAt])
  @@index([personalRating])
  @@map("favorite_scores")
}

model ScoreFavoriteStats {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  workId      String      @db.ObjectId
  scoreId     String
  scoreSource ScoreSource @default(IMSLP)

  // Estatísticas
  totalFavorites Int       @default(0)
  avgRating      Float? // Média das avaliações pessoais
  lastFavorited  DateTime? // Última vez que foi favoritado

  // Cache das informações da partitura
  scoreTitle  String
  scoreType   IMSLPScoreType
  downloadUrl String?

  // Metadados do cache
  lastUpdated DateTime @default(now())

  // Relação
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade) // 🔄 CASCADE quando deletar work

  // Índices
  @@unique([workId, scoreId, scoreSource], name: "work_score_stats_unique")
  @@index([workId, totalFavorites]) // Para buscar mais favoritadas por obra
  @@index([scoreSource, totalFavorites]) // Para rankings globais
  @@index([avgRating])
  @@map("score_favorite_stats")
}

// Novo modelo para histórico de uploads
model UploadHistory {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @db.ObjectId
  entityType String // "composer", "work", "score"
  entityId   String  @db.ObjectId
  action     String // "create", "update", "delete"
  changes    Json? // Detalhes das mudanças
  reason     String? // Razão para a mudança
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("upload_history")
}

// 🔄 MODELO ATUALIZADO COM CASCADE PARA RESOLVER O ERRO
model UploadModeration {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  entityType  String // "composer", "work", "score"
  entityId    String  @db.ObjectId
  reportedBy  String  @db.ObjectId
  moderatedBy String? @db.ObjectId

  reason      String // Motivo do report
  description String? // Descrição detalhada
  status      String  @default("pending") // "pending", "approved", "rejected"

  // Novos campos para melhor rastreamento
  priority String  @default("normal") // "low", "normal", "high", "urgent"
  category String? // Categoria adicional se necessário

  moderationNotes String? // Notas do moderador
  resolution      String? // Resolução tomada

  // Campos de auditoria
  ipAddress String? // IP do usuário que reportou
  userAgent String? // User agent do navegador

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // 🔄 RELAÇÕES ATUALIZADAS COM CASCADE - RESOLVE O ERRO
  reporter  User  @relation("ReportedUploads", fields: [reportedBy], references: [id], onDelete: Cascade)
  moderator User? @relation("ModeratedUploads", fields: [moderatedBy], references: [id], onDelete: SetNull)

  // Índices otimizados
  @@index([entityType, entityId])
  @@index([status, priority])
  @@index([reportedBy])
  @@index([moderatedBy])
  @@index([createdAt])
  @@index([reason])
  @@index([category])
  @@map("upload_moderation")
}

model GeneratedReport {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  type   String // 'users-overview', 'content-analysis', etc.
  format String // 'pdf', 'excel', 'csv'
  period String // '7d', '30d', '90d', '1y'

  // Metadados do arquivo
  filename      String
  filePath      String? // Caminho no sistema de arquivos ou URL
  fileSize      String? // Tamanho formatado (ex: "1.2 MB")
  fileSizeBytes Int? // Tamanho em bytes

  // Status e dados
  status String  @default("generating") // 'generating', 'ready', 'failed'
  error  String? // Mensagem de erro se falhou

  // Dados estatísticos do período (cache)
  reportData Json? // Dados estatísticos utilizados no relatório

  // Metadados de geração
  generatedBy String   @db.ObjectId
  generatedAt DateTime @default(now())

  // Controle de acesso e limpeza
  downloadCount Int @default(0)

  // Relações
  user User @relation("GeneratedReports", fields: [generatedBy], references: [id], onDelete: Cascade)

  // Índices
  @@index([type, status])
  @@index([status])
  @@index([generatedAt])
  @@map("generated_reports")
