// ==================== BLOG ARTICLE ====================
model BlogArticle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ===== CAMPOS BÁSICOS =====
  title             String              // Título do artigo
  slug              String              @unique // URL amigável (único)
  description       String?             // Descrição curta (preview/SEO)
  content           Json                // Conteúdo rico (JSON com blocos)
  
  // Imagem de capa
  coverImage        String?             // URL da imagem de capa
  coverImageAlt     String?             // Alt text da imagem
  coverImageCredit  String?             // Crédito do fotógrafo
  ttsAudioUrl       String?  // ✅ NOVO

  // Status e visibilidade
  status            ArticleStatus       @default(DRAFT)
  isFeatured        Boolean             @default(false) // Artigo em destaque (máx 5)
  featuredOrder     Int?                // Ordem no carrossel de destaques (1-5)
  
  // ===== TIPOS E CATEGORIAS =====
  types             ArticleType[]       @default([]) // Múltiplos tipos possíveis
  
  // Autor
  authorId          String              @db.ObjectId
  author            User                @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Co-autores (opcional)
  coAuthorIds       String[]            @default([]) @db.ObjectId
  
  // ===== DATAS =====
  publishedAt       DateTime?           // Data de publicação
  scheduledFor      DateTime?           // Agendado para (se SCHEDULED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  readTime          Int?                @default(0)
  // ===== VINCULAÇÕES COM OPUS ATLAS =====
  // Compositores vinculados
  composerIds       String[]            @default([]) @db.ObjectId
  
  // Obras vinculadas
  workIds           String[]            @default([]) @db.ObjectId
  
  // Partituras vinculadas
  scoreIds          String[]            @default([]) // IDs das partituras (WorkScore.sourceId)
  
  // Instrumentos vinculados
  instrumentIds     String[]            @default([]) @db.ObjectId
  
  // Épocas vinculadas (múltiplas)
  epochIds          String[]            @default([]) @db.ObjectId
  
  // ===== MÚSICA DE FUNDO =====
  backgroundMusicUrl     String?        // URL do YouTube/externa
  backgroundMusicTitle   String?        // Título da música
  backgroundMusicVolume  Float?         @default(0.3) // Volume (0.0 - 1.0)
  backgroundMusicLoop    Boolean        @default(true) // Loop
  backgroundMusicAutoplay Boolean       @default(true) // Autoplay
  
  // ===== MÉTRICAS =====
  viewCount         Int                 @default(0) // Visualizações
  readCount         Int                 @default(0) // Leituras completas
  avgReadTime       Int?                // Tempo médio de leitura (segundos)
  estimatedReadTime Int?                // Tempo estimado (calculado)
  
  // ===== SEO =====
  metaTitle         String?             // Meta title customizado
  metaDescription   String?             // Meta description customizada
  keywords          String[]            @default([]) // Keywords para SEO
  
  // ===== VERSIONING =====
  version           Int                 @default(1) // Versão atual
  
  // ===== RELAÇÕES =====
  categories        BlogArticleCategory[]  // M-N com categorias
  tags              BlogArticleTag[]       // M-N com tags
  media             BlogMedia[]            // Galeria de mídia
  comments          BlogComment[]          // Comentários
  likes             BlogLike[]             // Curtidas
  bookmarks         BlogBookmark[]         // Salvos
  versions          BlogArticleVersion[]   // Histórico de versões
  
  // ===== ÍNDICES =====
  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([isFeatured, featuredOrder])
  @@index([status, isFeatured])
  @@index([publishedAt])
  @@index([types])
  @@index([viewCount])
  @@map("blog_articles")
}

// ==================== BLOG CATEGORY ====================
model BlogCategory {
