// 🔄 MODELO ADVERTISEMENT ATUALIZADO COM SetNull
model Advertisement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Informações básicas
  title       String
  description String?
  content     String? // Conteúdo HTML/texto adicional

