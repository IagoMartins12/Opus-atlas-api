// TABELA DE AULAS COMPLETA
model Lesson {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String @db.ObjectId
  studentId String @db.ObjectId

  // Informações básicas
  title       String
  description String?
  objectives  String[] @default([]) // Objetivos da aula

  // Agendamento e duração
  scheduledAt     DateTime
  duration        Int       @default(60) // em minutos
  actualStartTime DateTime? // Hora real de início
  actualEndTime   DateTime? // Hora real de fim

  // Status e tipo
  status   LessonStatus @default(SCHEDULED)
  type     LessonType   @default(INDIVIDUAL)
  location String? // "Online", "Estúdio A", "Casa do aluno"

  // Sistema de recorrência
  isRecurring    Boolean        @default(false)
  recurrenceType RecurrenceType @default(NONE)
  parentLessonId String?        @db.ObjectId // Aula pai da série
  recurrenceEnd  DateTime? // Data fim da recorrência

  // Conteúdo e materiais da aula
  workScoreIds String[] @default([]) @db.ObjectId // Partituras específicas
  worksIds     String[] @default([]) @db.ObjectId // Partituras específicas  
  topics       String[] @default([]) // Tópicos abordados
  techniques   String[] @default([]) // Técnicas trabalhadas
  repertoire   String[] @default([]) // Repertório estudado

  // Homework e tarefas
  homework       String? // Lição de casa geral
  practiceGoals  String[] @default([]) // Metas específicas de prática
  nextLessonPrep String? // Preparação para próxima aula

  // Anotações e feedback
  teacherNotes    String? // Notas privadas do professor
  publicNotes     String? // Notas visíveis para o aluno
  studentFeedback String? // Feedback do aluno sobre a aula
  lessonSummary   String? // Resumo da aula

  // Avaliação e progresso
  studentProgress Json? // Progresso específico da aula
  skillsWorked    String[] @default([]) // Habilidades trabalhadas
  improvements    String[] @default([]) // Melhorias observadas
  challenges      String[] @default([]) // Desafios encontrados

  // Presença e participação
  studentPresent Boolean? // null = não marcado
  punctuality    String? // "on_time", "late", "early"
  engagement     Int? // 1-5 nível de engajamento
  preparation    Int? // 1-5 quão preparado estava

  // Informações de cancelamento/reagendamento
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String? // "teacher", "student", "system"
  rescheduledFrom  DateTime? // Data original se foi reagendada
  rescheduleReason String?

  // Mídia e recursos
  audioRecordings String[] @default([]) // URLs de gravações
  videoRecordings String[] @default([]) // URLs de vídeos
  documents       String[] @default([]) // Documentos anexos
  images          String[] @default([]) // Fotos da aula

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  teacher      Teacher      @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  student      Student      @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  parentLesson Lesson?      @relation("LessonSeries", fields: [parentLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childLessons Lesson[]     @relation("LessonSeries")
  assignments  Assignment[] @relation("LessonAssignments")

  // Índices otimizados
  @@index([teacherId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@index([scheduledAt, status])
  @@index([isRecurring, recurrenceType])
  @@index([status, type])
  @@index([teacherId, studentId, scheduledAt]) // Para detecção de conflitos
  @@map("lessons")
}

// SISTEMA DE TAREFAS/ASSIGNMENTS MELHORADO
model Assignment {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  lessonId  String @db.ObjectId
  studentId String @db.ObjectId

  // Informações da tarefa
  title       String
  description String
  type        String @default("practice") // "practice", "theory", "listening", "composition"
  priority    String @default("medium") // "low", "medium", "high"

  // Recursos e materiais
  workScoreIds String[] @default([]) @db.ObjectId // Partituras para estudar
  worksIds     String[] @default([]) @db.ObjectId // Partituras para estudar

  exercises String[] @default([]) // Exercícios específicos

  // Metas específicas
  practiceGoals  String[] @default([]) // Metas de prática
  tempoTargets   Json? // Metas de tempo/andamento
  technicalGoals String[] @default([]) // Objetivos técnicos
  musicalGoals   String[] @default([]) // Objetivos musicais

  // Status e prazos
  status        AssignmentStatus @default(PENDING)
  dueDate       DateTime?
  estimatedTime Int? // Tempo estimado em minutos
  actualTime    Int? // Tempo real gasto pelo aluno

  // Progresso e completion
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  progress    Float?    @default(0) // 0-100%

  // Feedback e avaliação
  teacherFeedback String? // Feedback do professor
  teacherRating   Int? // 1-5 avaliação do professor
  studentNotes    String? // Notas do aluno
  studentRating   Int? // 1-5 dificuldade percebida pelo aluno

  // Submissões do aluno
  submissions    Json? // Gravações, fotos, etc. enviadas pelo aluno
  submissionDate DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  lesson  Lesson  @relation("LessonAssignments", fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  // Índices otimizados
  @@index([studentId, status])
  @@index([studentId, dueDate])
  @@index([lessonId, status])
  @@index([status, dueDate])
  @@index([type, priority])
  @@map("assignments")
}

model Notification {
  id       String               @id @default(auto()) @map("_id") @db.ObjectId
  userId   String               @db.ObjectId
  type     NotificationType
  priority NotificationPriority @default(MEDIUM)
  status   NotificationStatus   @default(UNREAD)

  // Conteúdo da notificação
  title      String
  message    String
  actionText String? // Texto do botão (ex: "Ver Aula", "Marcar como Feito")
  actionUrl  String? // URL para onde levar o usuário

  // Dados relacionados (para construir links dinâmicos)
  relatedEntityType String? // "lesson", "assignment", "student", etc.
  relatedEntityId   String? @db.ObjectId

  // 🆕 CAMPO PARA PREVENÇÃO DE DUPLICATAS
  uniqueHash String? // Hash único baseado em tipo + entidade + metadata específicos

  // Metadados adicionais
  metadata Json? // Dados extras específicos por tipo

  // Configurações de exibição
  showInToast   Boolean @default(true) // Mostrar como toast
  showInBrowser Boolean @default(false) // Mostrar como notificação browser
  showInPage    Boolean @default(true) // Mostrar na página de notificações

  // Controle de repetição (REMOVIDO cooldown)
  lastShownAt DateTime? // Última vez que foi mostrada como toast

  // Agendamento
  scheduledFor DateTime? // Quando deve ser mostrada (para agendamentos futuros)
  expiresAt    DateTime? // Data de expiração (auto-cleanup)

  // Controle de entrega
  toastShown   Boolean @default(false) // Toast já foi mostrado
  browserShown Boolean @default(false) // Notificação browser já foi mostrada

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime? // Quando foi marcada como lida

  // Relações
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // 🆕 CONSTRAINT OPCIONAL PARA HASH ÚNICO (se quiser garantir a nível de DB)
  // @@unique([uniqueHash], name: "unique_notification_hash")

  // 🆕 ÍNDICES OTIMIZADOS PARA PREVENÇÃO DE DUPLICATAS
  @@index([userId, status, createdAt])
  @@index([userId, type, status])
  @@index([scheduledFor, status])
  @@index([expiresAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([priority, status, createdAt])
  @@index([showInToast, toastShown])
  @@index([showInBrowser, browserShown])
  // 🆕 ÍNDICES PARA PREVENÇÃO DE DUPLICATAS
  @@index([userId, type, relatedEntityId, status]) // Principal para verificar duplicatas
  @@index([uniqueHash]) // Para verificação rápida por hash
  @@index([userId, type, relatedEntityId, expiresAt]) // Para verificação com expiração
  @@map("notifications")
}

model SchoolActivity {
