// ==================== MODELO DE ASSINATURA ====================
model Subscription {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Relacionamento com usuário
  userId String @db.ObjectId
  user   User   @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  
  // Plano e período
  planType      PlanType       @default(FREE)
  billingPeriod BillingPeriod? // null para FREE
  
  // Status
  status SubscriptionPlanStatus @default(ACTIVE)
  
  // 🔁 Stripe integration
  stripeSessionId    String?   // session.id
  stripeCheckoutUrl  String?   // session.url
  stripeSubscriptionId String? // depois do webhook
  stripeCustomerId    String?

  // Datas
  startDate     DateTime  @default(now())
  endDate       DateTime? // null = indefinido (FREE)
  trialEndDate  DateTime? // Data fim do trial
  cancelledAt   DateTime? // Data do cancelamento
  
  // Financeiro
  price         Float?   // Preço mensal/anual
  currency      String   @default("BRL")
  autoRenew     Boolean  @default(true)
  
  // Mercado Pago
  mpSubscriptionId   String? // ID da assinatura MP (se recorrente)
  
  // Cupom aplicado
  couponId String? @db.ObjectId
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  
  // Metadados
  metadata Json? // Dados extras (ex: features específicas)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  payments  Payment[]
  invoices  Invoice[]
  history   SubscriptionHistory[]
  
  @@index([userId, status])
  @@index([status, endDate])
  @@index([planType, status])
  @@map("subscriptions")
}

// ==================== MODELO DE PAGAMENTO ====================
model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Relacionamento
  subscriptionId String       @db.ObjectId
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeSessionId String?
  // Valores
  amount        Float
  currency      String  @default("BRL")
  discountAmount Float? @default(0) // Desconto aplicado
  finalAmount   Float   // Valor final pago
  
  // Status e método
  status        PaymentStatus
  paymentMethod PaymentMethod?
  
  // Mercado Pago
  mpPaymentId        String? @unique // ID do pagamento no MP
  mpStatus           String? // Status original do MP
  mpStatusDetail     String? // Detalhe do status MP
  
  // Dados do pagamento
  payerEmail String?
  payerName  String?
  payerDocument String? // CPF/CNPJ
  
  // Datas
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Metadados
  metadata Json? // Dados extras do MP
  
  // Relação com nota fiscal
  invoice Invoice?
  
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@map("payments")
}

// ==================== MODELO DE NOTA FISCAL ====================
model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Relacionamentos
  subscriptionId String       @db.ObjectId
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  paymentId String  @unique @db.ObjectId
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  // Número da nota
  invoiceNumber String @unique // Ex: NF-2024-001234
  
  // Valores
  amount       Float
  taxAmount    Float  @default(0)
  totalAmount  Float
  currency     String @default("BRL")
  
  // Status
  status InvoiceStatus @default(PENDING)
  
  // Datas
  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidAt    DateTime?
  
  // Dados do cliente
  customerName     String
  customerEmail    String
  customerDocument String  // CPF/CNPJ
  customerAddress  String?
  customerCity     String?
  customerState    String?
  customerZipCode  String?
  
  // Dados da empresa (Opus Atlas)
  companyName     String @default("Opus Atlas Ltda")
  companyDocument String @default("00.000.000/0000-00") // CNPJ fictício
  companyAddress  String @default("São Paulo, SP")
  
  // Arquivo PDF
  pdfUrl String? // URL do PDF gerado
  
  // Descrição
  description String // Descrição do serviço
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([subscriptionId])
  @@index([status, dueDate])
  @@map("invoices")
}

// ==================== HISTÓRICO DE ASSINATURAS ====================
model SubscriptionHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Relacionamento
  subscriptionId String       @db.ObjectId
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  userId String @db.ObjectId
  
  // Ação realizada
  action String // CREATED, UPGRADED, DOWNGRADED, CANCELLED, REACTIVATED, RENEWED, EXPIRED
  
  // Planos
  fromPlan PlanType?
  toPlan   PlanType?
  
  // Valores (se aplicável)
  fromPrice Float?
  toPrice   Float?
  
  // Motivo
  reason String? // Motivo da mudança (ex: "upgrade manual", "trial expirado")
  
  // Metadados
  metadata Json? // Dados extras
  
  // Timestamp
  createdAt DateTime @default(now())
  
  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
  @@map("subscription_history")
}

// ==================== MODELO DE CUPOM ====================
model Coupon {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Código do cupom
  code String @unique // Ex: "BEMVINDO20", "PROMO50"
  
  // Tipo e valor
  type           CouponType
  discountValue  Float      // 20 (para 20% ou R$ 20)
  maxDiscount    Float?     // Desconto máximo (para percentual)
  
  // Aplicável a quais planos
  applicablePlans PlanType[] @default([]) // [] = todos os planos
  
  // Período de validade
  validFrom  DateTime
  validUntil DateTime
  
  // Limites de uso
  maxUses       Int?  // null = ilimitado
  usedCount     Int   @default(0)
  maxUsesPerUser Int? @default(1) // Quantas vezes cada usuário pode usar
  
  // Status
  isActive Boolean @default(true)
  
  // Trial estendido (se aplicável)
  extraTrialDays Int? // Dias extras de trial
  
  // Descrição
  description String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  subscriptions Subscription[]
  usages        CouponUsage[]
  
  @@index([code, isActive])
  @@index([validFrom, validUntil])
  @@map("coupons")
}

// ==================== USO DE CUPONS ====================
model CouponUsage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Relacionamentos
  couponId String @db.ObjectId
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  
  userId String @db.ObjectId
  user   User   @relation("UserCouponUsages", fields: [userId], references: [id], onDelete: Cascade)
  
  // Valor do desconto aplicado
  discountApplied Float
  
  // Timestamp
  usedAt DateTime @default(now())
  
  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_usages")
}

model PlanPricing {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Tipo de plano
  planType PlanType // FREE, PLUS, MENTOR, MAESTRO
  
  // Preços por período
  monthlyPrice    Float  @default(0)
  quarterlyPrice  Float? // Trimestral
  biannualPrice   Float? // Semestral
  yearlyPrice     Float? // Anual
  
  // Descontos aplicados (%)
  quarterlyDiscount Float @default(10) // 10% desconto
  biannualDiscount  Float @default(15) // 15% desconto
  yearlyDiscount    Float @default(20) // 20% desconto
  
  // Dias de trial
  trialDays Int @default(0)
  
  // Status
  isActive Boolean @default(true)
  
  // Metadados
  features     Json? // Features incluídas no plano
  description  String?
  displayOrder Int    @default(0) // Ordem de exibição
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Constraint: apenas um preço ativo por plano
  @@index([planType])
  @@index([isActive])
  @@map("plan_pricing")
}

// ==================== SISTEMA DE EVENTOS ====================

enum EventType {
  CONCERT          // Concerto
  RECITAL          // Recital
  OPEN_REHEARSAL
  OPERA            // Ópera
  CHAMBER_MUSIC    // Música de Câmara
  ORCHESTRA        // Orquestra Sinfônica
  MASTERCLASS      // Masterclass
  WORKSHOP         // Workshop
  FESTIVAL         // Festival
  COMPETITION      // Competição
  LECTURE          // Palestra
  EXHIBITION       // Exposição
  OTHER            // Outro
  CHOIR
  BALLET
  CHORAL
}

enum EventStatus {
  DRAFT            // Rascunho (ainda não publicado)
  PENDING          // Pendente aprovação (se veio de scraper ou usuário)
  PUBLISHED        // Publicado (aprovado e visível)
  CANCELLED        // Cancelado
  POSTPONED        // Adiado
  COMPLETED        // Finalizado
}

enum EventSource {
  SCRAPER          // Vindo do scraper automático
  ADMIN            // Cadastrado por admin
  USER             // Cadastrado por usuário comum
  VENUE            // Cadastrado pela própria sala
  IMPORT           // Importado de fonte externa
}

// ==================== SALAS DE CONCERTO ====================
model Venue {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Identificação
  name        String              // "Sala São Paulo", "Teatro Amazonas"
  slug        String    @unique   // URL amigável
  shortName   String?             // Abreviação (ex: "OSESP")
  
  // Localização
  city        String              // "São Paulo"
  state       String              // "SP"
  country     String    @default("Brasil")
  address     String?             // Endereço completo
  zipCode     String?
  
  // Informações de contato
  website     String?
  email       String?
  phone       String?
  
  // Características da sala
  capacity    Int?                // Capacidade total
  description String?             // Descrição da sala
  history     String?             // História da sala
  
  // Mídia
  logoUrl       String?
  coverImageUrl String?
  galleryImages String[] @default([])
  
  // Dados para scraping
  scrapingEnabled Boolean @default(false)
  scrapingUrl     String?         // URL da página de eventos
  scrapingConfig  Json?           // Config específica de scraping
  lastScrapedAt   DateTime?
  scrapingStatus  String?         // "success", "error", "pending"
  scrapingError   String?
  
  // Metadados
  isVerified  Boolean  @default(false) // Verificado pela equipe
  isActive    Boolean  @default(true)
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  events Event[] @relation("VenueEvents")
  
  @@index([city, state])
  @@index([isActive])
  @@map("venues")
}

// ==================== EVENTOS ====================
model Event {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Identificação
  title       String
  slug        String    @unique
  subtitle    String?
  description String?             // Descrição curta
  fullDetails String?             // Detalhes completos (markdown/rich text)
  
  // Tipo e status
  type        EventType
  status      EventStatus @default(PENDING)
  source      EventSource @default(ADMIN)
  
  // Local
  venueId     String      @db.ObjectId
  venue       Venue       @relation("VenueEvents", fields: [venueId], references: [id], onDelete: Cascade)
  room        String?     // "Sala Principal", "Sala de Câmara"
  
  // Data e horário
  startDate   DateTime
  endDate     DateTime?   // Para eventos de múltiplos dias
  endTime     String?
    venueDetails     String?
    ticketInfo     String?

  startTime   String      // "20:00"
  duration    Int?        // Duração em minutos
  doors       String?     // Horário de abertura das portas
  // Programa
  program     Json?       // Estrutura detalhada do programa
  // Exemplo: [
  //   { composer: "ObjectId", work: "ObjectId", performer: "string" },
  //   { composer: "ObjectId", work: "ObjectId", performer: "string" }
  // ]
  
  // Vinculações com Opus Atlas
  composerIds     String[] @default([]) @db.ObjectId
  workIds         String[] @default([]) @db.ObjectId
  instrumentIds   String[] @default([]) @db.ObjectId
  epochIds        String[] @default([]) @db.ObjectId
  
  // Artistas e performers
  performers      Json?    // Array de performers
  // Exemplo: [
  //   { name: "Yuja Wang", role: "Piano", bio: "..." },
  //   { name: "Gustavo Dudamel", role: "Maestro", bio: "..." }
  // ]
  
  conductor       String?  // Nome do maestro
  soloists        String[] @default([]) // Nomes dos solistas
  ensemble        String?  // Nome do grupo/orquestra
  
  // Ingressos
  ticketUrl       String?  // Link para compra

  ticketPrice     Json?    // Estrutura de preços
  // Exemplo: { min: 50, max: 200, currency: "BRL", categories: [...] }
  isFree          Boolean  @default(false)
  
  // Mídia
  imageUrl       String?  // Cartaz do evento
  coverImageUrl   String?
  galleryImages   String[] @default([])
  videoUrl        String?  // Trailer/teaser
  
  // Acessibilidade
  ageRating       String?  // Classificação etária
  
  // Destaque e featured
  isFeatured      Boolean  @default(false)
  featuredOrder   Int?     // Ordem no carrossel
  
  // Dados de scraping (se aplicável)
  externalId    String?     
  externalUrl     String?  // URL original do evento
  scrapedData     Json?    // Dados brutos do scraping
  
  // Moderação e qualidade
  isVerified      Boolean  @default(false)
  verifiedBy      String?  @db.ObjectId
  verifiedAt      DateTime?
  
  qualityScore    Int?     // Score de qualidade dos dados (0-100)
  completeness    Float?   // % de campos preenchidos
  
  // Submissão por usuário
  submittedBy     String?  @db.ObjectId
  submittedAt     DateTime?
  
  // Métricas
  viewCount       Int      @default(0)
  
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  
  // Relações
  reminders    EventReminder[] @relation("EventReminders")
  
  @@index([venueId, startDate])
  @@index([externalId])
  @@index([status, startDate])
  @@index([type, startDate])
  @@index([isFeatured, startDate])
  @@index([composerIds])
  @@index([source, status])
  @@map("events")
}


// ==================== LEMBRETES DE EVENTOS ====================
model EventReminder {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  eventId String @db.ObjectId
  event   Event  @relation("EventReminders", fields: [eventId], references: [id], onDelete: Cascade)
  
  userId String @db.ObjectId
  user   User   @relation("UserEventReminders", fields: [userId], references: [id], onDelete: Cascade)
  
  // Quando lembrar
  reminderTime DateTime  // Data/hora do lembrete
  reminderType String    // "1_day_before", "1_hour_before", "custom"
  
  // Status
  sent       Boolean   @default(false)
  sentAt     DateTime?
  
  // Canal
  channel String @default("notification") // "notification", "email", "both"
  
  createdAt DateTime @default(now())
  
  @@unique([eventId, userId, reminderTime])
  @@index([reminderTime, sent])
  @@map("event_reminders")
}

// ==================== LOG DE SCRAPING ====================
model ScrapingLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  venueId String? @db.ObjectId
  
  // Metadados do scraping
  source      String    // "osesp", "teatro_amazonas", etc
  status      String    // "success", "partial", "error"
  newEvents      Int      // ✅ CORRETO (não 'eventsAdded')

  // Estatísticas
  eventsFound    Int @default(0)
  eventsCreated  Int @default(0)
  eventsUpdated  Int @default(0)
  eventsSkipped  Int @default(0)
  
  // Dados
  duration    Int?      // Duração em ms
  error       String?   // Mensagem de erro (se houver)
  details     Json?     // Detalhes adicionais
  
  // Timestamps
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  
  @@index([source, startedAt])
  @@index([status])
  @@map("scraping_logs")
}