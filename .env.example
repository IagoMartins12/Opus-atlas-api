# =============================================================================
# Opus Atlas API — variáveis de ambiente
# =============================================================================
# Um arquivo por ambiente, escolhido por APP_ENV (ver src/config/env-files.ts):
#
#   npm run start:local  -> APP_ENV=local -> .env.local  (NODE_ENV=development)
#   npm run start:dev    -> APP_ENV=hml   -> .env.hml    (NODE_ENV=staging)
#   npm run start        -> APP_ENV=prd   -> .env.prd    (NODE_ENV=production)
#   (start:hml e start:prod rodam o build, dist/, com o mesmo arquivo)
#
# Copie este exemplo para o arquivo do ambiente e preencha. NÃO crie um `.env`
# puro: o Prisma Client o carrega sozinho e ele venceria o arquivo do ambiente
# (a API se recusa a subir com ele). Prisma CLI: npm run prisma:push / studio.
#
# As marcadas [PROD] são OBRIGATÓRIAS quando NODE_ENV=production: a aplicação
# se recusa a subir sem elas (fail-fast). Variável vazia conta como não definida.
# Variável do processo (orquestrador, shell) sempre vence o arquivo.
#
# Nunca comite os .env reais. Só este exemplo é versionado.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# local | hml | prd. Normalmente vem do script do npm; aqui só documenta.
APP_ENV=local
NODE_ENV=development
PORT=4000

# Quantos proxies reversos existem à frente da API (Nginx, Cloudflare, ALB).
# Sem isso o Express usa o IP do proxy e o rate limit por IP vira um balde
# único compartilhado por todos os usuários.
TRUST_PROXY_HOPS=1

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL="mongodb://localhost:27017/classical_hub"
# Conexões com o MongoDB por processo (padrão 10 e 2).
# O cluster vê `maxPoolSize × (réplicas de api + worker)` conexões; deixe a
# soma abaixo do limite do seu plano. Ver `src/prisma/pool.ts`.
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=2

# --- Autenticação ------------------------------------------------------------
# Mínimo de 32 caracteres cada. Use segredos distintos: um refresh token não
# pode ser aceito como access token.
#   openssl rand -base64 48
JWT_ACCESS_SECRET="troque-por-um-segredo-de-no-minimo-32-caracteres"
JWT_REFRESH_SECRET="outro-segredo-diferente-de-no-minimo-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domínio raiz do cookie httpOnly de refresh. Em produção use o domínio raiz
# (.opusatlas.com.br) para a mesma sessão valer nas 4 zonas do front sem novo
# login. Deixe vazio em desenvolvimento: localhost não aceita domínio com ponto.
AUTH_COOKIE_DOMAIN=
# Só na homologação: opus_hml (igual a NEXT_PUBLIC_AUTH_COOKIE_PREFIX no front).
# Vazio = opus, o de produção. Evita colisão com os cookies de produção.
AUTH_COOKIE_PREFIX=

# Login com Google, feito pela API (fluxo de código com PKCE). Serve o mesmo
# cliente OAuth do NextAuth; cadastre o GOOGLE_OAUTH_REDIRECT_URI em "URIs de
# redirecionamento autorizados" no Google Cloud Console. Obrigatórias em produção.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# --- Redis -------------------------------------------------------------------
# [PROD] Além do cache, é o storage do rate limit compartilhado entre
# instâncias. Sem ele, o limite deixa de valer assim que houver mais de uma
# réplica (cada uma contaria separado).
REDIS_URL="redis://localhost:6379"

# --- CORS --------------------------------------------------------------------
# [PROD] Lista separada por vírgula. Nunca use "*" com credenciais.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Rate limiting -----------------------------------------------------------
# Limite global. Rotas sensíveis (login, cupom, contato) têm limites próprios,
# menores, definidos em código com @Throttle.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Segurança ---------------------------------------------------------------
# [PROD] Protege rotas server-to-server: /api/metrics, /api/cron/*, scrapers.
# Mínimo de 32 caracteres.
API_KEY=

# O Swagger fica desligado em produção por padrão, porque é registrado fora do
# pipeline de guards do Nest (o JwtAuthGuard global não o protege) e exporia o
# contrato inteiro da API. Só ligue com proteção na frente.
SWAGGER_ENABLED=

# --- Front -------------------------------------------------------------------
# [PROD] Base usada para montar links em e-mails (confirmação, reset de senha).
FRONTEND_BASE_URL="http://localhost:3000"

# --- E-mail transacional -----------------------------------------------------
# [PROD] Caminho crítico: sem SMTP ninguém confirma conta nem recupera senha.
# Em desenvolvimento, deixar vazio ativa o modo dry-run (o e-mail vai para o log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Opus Atlas <noreply@opusatlas.com>"
EMAIL_REPLY_TO="contato@opusatlas.com"

# Segredo de assinatura do webhook de entrega (Resend/Svix: começa com whsec_).
# Sem ele, POST /webhook/email recusa tudo: um `email.bounced` forjado
# desinscreve assinante, então a assinatura é a autenticação da rota.
EMAIL_WEBHOOK_SECRET=
SUPPORT_EMAIL="suporte@opusatlas.com"

# --- Stripe ------------------------------------------------------------------
# [PROD] Chaves de produção. Em qualquer outro ambiente valem as _TEST abaixo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# IDs de Price criados no dashboard do Stripe. Nunca criar Product/Price
# dinamicamente a cada checkout (o legado fazia isso e poluía o dashboard).
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_MENTOR_MONTHLY=
STRIPE_PRICE_MENTOR_YEARLY=
STRIPE_PRICE_MAESTRO_MONTHLY=
STRIPE_PRICE_MAESTRO_YEARLY=

# --- Armazenamento de arquivos (Cloudinary) ----------------------------------
# [PROD] Todo arquivo da plataforma vive no Cloudinary. Não há gravação em disco
# local: contêiner é efêmero e réplicas não compartilham disco, então arquivo
# salvo localmente some no próximo deploy e não é visível para as outras
# instâncias.
#
# Dev e produção podem usar a mesma conta com segurança: a API prefixa toda
# pasta com o ambiente (`opus/{NODE_ENV}/...`), então um teste local nunca
# toca em arquivo de produção.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observabilidade ---------------------------------------------------------
# Vazio desativa o error tracking. Sem DSN a aplicação sobe normalmente.
SENTRY_DSN=
# Marca o deploy para correlacionar regressão a release.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
GIT_COMMIT_SHA=

LOG_LEVEL=info

# --- Busca -------------------------------------------------------------------
# Os índices de texto do MongoDB são criados no boot, de forma idempotente.
# "true" desativa (útil em CI e em bancos somente-leitura).
SKIP_TEXT_INDEX_BOOTSTRAP=

# --- APIs externas (opcionais) -----------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Google Text-to-Speech (blog): caminho do JSON da conta de serviço.
# Guardar em ./.config/ (ignorada pelo git e pelo Docker). Vazio: gerar áudio responde 503.
GOOGLE_APPLICATION_CREDENTIALS=

# --- IA: biografia de compositor, em cascata --------------------------------
# Ordem de tentativa (anthropic, openai, groq); provedor sem chave é pulado.
# Trocar ordem ou modelo não pede deploy de código. Sem nenhuma chave, a geração
# responde 503 e o resto da API funciona normalmente.
AI_PROVIDER_ORDER=anthropic,openai,groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Quanto o Claude pensa antes de escrever (low | medium | high). Biografia
# não pede raciocínio longo; medium equilibra custo e cuidado com os fatos.
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq é gratuito: bom último recurso.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tempo máximo por provedor, em ms.
AI_TIMEOUT_MS=60000
# Teto de chamadas de IA por dia para biografia (geração + tradução). A página
# do compositor é pública; sem teto, um robô percorrendo o catálogo vira custo.
AI_BIO_DAILY_LIMIT=200

# Aviso de dado novo ao front (Etapa 1.7). A API faz POST { tags } para esta URL
# sempre que um dado muda, assinado no cabeçalho x-revalidate-secret. Vazio: desligado.
FRONT_REVALIDATE_URL=
# Obrigatório quando a URL existe; no mínimo 32 caracteres.
FRONT_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Backup do banco (opcional)
#
# Fica no Cloudflare R2, e não no Cloudinary, por dois motivos independentes:
# o Cloudinary entrega por URL pública (e um backup tem e-mail, hash de senha
# e histórico de pagamento de todo mundo) e limita arquivo bruto a 10-100 MB
# conforme o plano.
#
# Sem estas variáveis a aplicação sobe normalmente: a tarefa de backup recusa
# rodar e a tela de /admin/backup diz o que falta.
# ---------------------------------------------------------------------------
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=backups

# Conexões do Mongo por processo. O driver abre até 100 por padrão: com N
# réplicas o teto vira N x 100 e o cluster corta antes.
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=2
