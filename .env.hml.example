# =============================================================================
# HOMOLOGAÇÃO — API no Render (branch develop)
# =============================================================================
# No Render estas variáveis vão no painel (Environment), não em arquivo.
# Este esqueleto serve para:
#   1. conferir antes de colar:  cp .env.hml.example .env.hml → preencher →
#      npm run build && npm run env:check -- hml
#   2. rodar os scripts contra o banco da homologação (prisma:push:hml).
#
# Onde pegar cada valor: cérebro "Credenciais — passo a passo"
# (cerebros/cerebro-backend/Operação). <…> = você preenche.
# Regra de ouro: NENHUM segredo gerado aqui pode ser igual ao de produção.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=hml
NODE_ENV=staging
# No Render, NÃO defina PORT: ele injeta a própria e a API a lê.
LOG_LEVEL=info
# Um contêiner só: enfileira E consome. Sem isso, jobs nunca rodam.
QUEUE_ROLE=all
# Render tem um balanceador na frente.
TRUST_PROXY_HOPS=1

# --- Banco e cache -----------------------------------------------------------
# Atlas M0. O nome do banco (opus-hml) TEM de estar no caminho.
DATABASE_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/opus-hml?retryWrites=true&w=majority
# Render Key Value → "Internal Key Value URL".
REDIS_URL=redis://<red-xxxxxxxx>:6379

# --- Segredos gerados (openssl rand -base64 48) — novos, só da homologação ---
JWT_ACCESS_SECRET=<gerar>
JWT_REFRESH_SECRET=<gerar>
API_KEY=<gerar>
# O MESMO valor vai no FRONT_REVALIDATE_SECRET da Vercel.
FRONT_REVALIDATE_SECRET=<gerar>

# --- Endereços ---------------------------------------------------------------
FRONTEND_BASE_URL=https://hml.opusatlas.com.br
ALLOWED_ORIGINS=https://hml.opusatlas.com.br
FRONT_REVALIDATE_URL=https://hml.opusatlas.com.br/api/revalidate
SUPPORT_EMAIL=contato@opusatlas.com.br

# --- Sessão ------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=.hml.opusatlas.com.br
# Igual ao NEXT_PUBLIC_AUTH_COOKIE_PREFIX da Vercel.
AUTH_COOKIE_PREFIX=opus_hml

# --- Login com Google (cliente OAuth "Opus Atlas — hml") ---------------------
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<...>
GOOGLE_OAUTH_REDIRECT_URI=https://api.hml.opusatlas.com.br/api/auth/google/callback

# --- E-mail (Resend, chave "hml") --------------------------------------------
SMTP_HOST=smtp.resend.com
# 2465, não 465: o Render gratuito bloqueia a saída nas portas SMTP padrão
# (25, 465, 587) — a conexão fica pendurada. O Resend aceita 2465 (SSL) e
# 2587 (STARTTLS) justamente para isso. O Gmail não tem porta alternativa.
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<re_... chave do Resend da homologação>
EMAIL_FROM=Opus Atlas (homologação) <noreply@opusatlas.com.br>
EMAIL_REPLY_TO=contato@opusatlas.com.br
# Webhook do Resend apontando para https://api.hml.opusatlas.com.br/api/webhook/email
EMAIL_WEBHOOK_SECRET=<whsec_...>

# --- Stripe: SÓ modo teste. Nunca STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET aqui
STRIPE_SECRET_KEY_TEST=<sk_test_...>
# Webhook de teste → https://api.hml.opusatlas.com.br/api/webhook/stripe
STRIPE_WEBHOOK_SECRET_TEST=<whsec_...>
# IDs dos preços criados no MODO TESTE (price_...).
STRIPE_PRICE_PLUS_MONTHLY=<price_...>
STRIPE_PRICE_PLUS_YEARLY=<price_...>
STRIPE_PRICE_MENTOR_MONTHLY=<price_...>
STRIPE_PRICE_MENTOR_YEARLY=<price_...>
STRIPE_PRICE_MAESTRO_MONTHLY=<price_...>
STRIPE_PRICE_MAESTRO_YEARLY=<price_...>

# --- Arquivos (mesma conta do Cloudinary; a pasta opus/staging é automática) --
CLOUDINARY_CLOUD_NAME=<...>
CLOUDINARY_API_KEY=<...>
CLOUDINARY_API_SECRET=<...>

# --- Backup (mesmo bucket; a pasta backups/staging é automática) --------------
BACKUP_R2_ACCOUNT_ID=<...>
BACKUP_R2_ACCESS_KEY_ID=<...>
BACKUP_R2_SECRET_ACCESS_KEY=<...>
BACKUP_R2_BUCKET=opus-atlas-backups
# BACKUP_R2_PREFIX=   ← deixe vazio

# --- Texto para voz do blog (Google Cloud TTS) ---------------------------------
# No Render: Secret Files → nome google-tts.json.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-tts.json

# --- Mídia (busca de gravações) ----------------------------------------------
SPOTIFY_CLIENT_ID=<...>
SPOTIFY_CLIENT_SECRET=<...>
YOUTUBE_API_KEY=<...>

# --- Biografia por IA (opcional; sem chave nenhuma, a geração responde 503) ---
AI_PROVIDER_ORDER=anthropic,openai,groq
# Sonnet 5: mais barato que o Opus e suficiente para biografia.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Limite baixo em homologação: é teste, não produção.
AI_BIO_DAILY_LIMIT=10

# --- Erros (opcional) --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
