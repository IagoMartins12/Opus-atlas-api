# =============================================================================
# PRODUÇÃO — API no VPS (branch main)
# =============================================================================
# cp .env.prd.example .env.prd → preencher →
#   npm run build && npm run env:check -- prd
# No VPS, o arquivo chega ao contêiner pelo docker-compose (env_file), nunca
# pela imagem.
#
# Onde pegar cada valor: cérebro "Credenciais — passo a passo"
# (cerebros/cerebro-backend/Operação). <…> = você preenche.
# Regra de ouro: NENHUM segredo gerado aqui pode ser igual ao da homologação.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=prd
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Quantos proxies há na frente da API. Cloudflare com proxy ligado + o
# reverse proxy do VPS (nginx/traefik) = 2. Errado, o rate limit vê o IP do
# proxy e limita todo mundo junto. Confirme a sua topologia.
TRUST_PROXY_HOPS=2
# QUEUE_ROLE: não defina — os alvos api/worker do Dockerfile já definem.
# SWAGGER_ENABLED: não defina — em produção fica desligado.

# --- Banco e cache -----------------------------------------------------------
# O banco de PRODUÇÃO (não é o do seu .env.local). Nome do banco no caminho.
DATABASE_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>?retryWrites=true&w=majority
# Serviço redis do docker-compose. Com senha: redis://:<senha>@redis:6379
REDIS_URL=redis://redis:6379

# --- Segredos gerados (openssl rand -base64 48) — novos, só de produção ------
JWT_ACCESS_SECRET=<gerar>
JWT_REFRESH_SECRET=<gerar>
API_KEY=<gerar>
# O MESMO valor vai no FRONT_REVALIDATE_SECRET do front de produção.
FRONT_REVALIDATE_SECRET=<gerar>

# --- Endereços ---------------------------------------------------------------
FRONTEND_BASE_URL=https://opusatlas.com.br
ALLOWED_ORIGINS=https://opusatlas.com.br,https://www.opusatlas.com.br
FRONT_REVALIDATE_URL=https://opusatlas.com.br/api/revalidate
SUPPORT_EMAIL=contato@opusatlas.com.br

# --- Sessão ------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=.opusatlas.com.br
# AUTH_COOKIE_PREFIX: não defina — produção usa o padrão (opus).

# --- Login com Google (cliente OAuth "Opus Atlas — produção") -----------------
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<...>
GOOGLE_OAUTH_REDIRECT_URI=https://api.opusatlas.com.br/api/auth/google/callback

# --- E-mail (Resend com o domínio próprio, chave "prd") -----------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<re_... chave do Resend de produção>
EMAIL_FROM=Opus Atlas <noreply@opusatlas.com.br>
EMAIL_REPLY_TO=contato@opusatlas.com.br
# Webhook do Resend apontando para https://api.opusatlas.com.br/api/webhook/email
EMAIL_WEBHOOK_SECRET=<whsec_...>

# --- Stripe: SÓ modo vivo ------------------------------------------------------
STRIPE_SECRET_KEY=<sk_live_... ou rk_live_...>
# Webhook vivo → https://api.opusatlas.com.br/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=<whsec_...>
# IDs dos preços criados no MODO VIVO (são outros, não os de teste).
STRIPE_PRICE_PLUS_MONTHLY=<price_...>
STRIPE_PRICE_PLUS_YEARLY=<price_...>
STRIPE_PRICE_MENTOR_MONTHLY=<price_...>
STRIPE_PRICE_MENTOR_YEARLY=<price_...>
STRIPE_PRICE_MAESTRO_MONTHLY=<price_...>
STRIPE_PRICE_MAESTRO_YEARLY=<price_...>

# --- Arquivos (a pasta opus/production é automática) --------------------------
CLOUDINARY_CLOUD_NAME=<...>
CLOUDINARY_API_KEY=<...>
CLOUDINARY_API_SECRET=<...>

# --- Backup (a pasta backups/production é automática) --------------------------
BACKUP_R2_ACCOUNT_ID=<...>
BACKUP_R2_ACCESS_KEY_ID=<...>
BACKUP_R2_SECRET_ACCESS_KEY=<...>
BACKUP_R2_BUCKET=opus-atlas-backups
# BACKUP_R2_PREFIX=   ← deixe vazio

# --- Texto para voz do blog (Google Cloud TTS) ---------------------------------
# Montado pelo docker-compose (volume somente leitura), nunca copiado na imagem.
GOOGLE_APPLICATION_CREDENTIALS=/app/.config/google-tts.json

# --- Mídia (busca de gravações) ----------------------------------------------
SPOTIFY_CLIENT_ID=<...>
SPOTIFY_CLIENT_SECRET=<...>
YOUTUBE_API_KEY=<...>

# --- Biografia por IA ----------------------------------------------------------
AI_PROVIDER_ORDER=anthropic,openai,groq
ANTHROPIC_API_KEY=<...>
OPENAI_API_KEY=<...>
GROQ_API_KEY=<...>
AI_BIO_DAILY_LIMIT=100

# --- Erros ---------------------------------------------------------------------
SENTRY_DSN=<https://...@....ingest.sentry.io/...>
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE / GIT_COMMIT_SHA: o deploy preenche com o commit.
